# Copy to .env to point your local jspaint at a deployed multiplayer
# backend instead of a local one. Loaded by predev/postinstall - see
# scripts/generate-multiplayer-config.js. Re-run `npm run dev` (or
# `npm install`) after changing this file.

# wss://, not https:// - e.g. the deployed ggjh2027-multiplayer Worker.
PARTYKIT_HOST=

# Optional - the room used when the page has no ?room=<id>. Defaults to
# "main-canvas" if unset.
MULTIPLAYER_ROOM_ID=
